#!/bin/sh /etc/rc.common
USE_PROCD=1
START=96
STOP=10

start_service() {
	local data enabled port scope transport revision root cert key addresses address opt
	data="$(uci -q get sim-relay.main.data)" || return 0
	enabled="$(printf '%s' "$data" | jsonfilter -e '@.api.enabled')"
	[ "$enabled" = 1 ] || return 0
	port="$(printf '%s' "$data" | jsonfilter -e '@.api.port')"
	scope="$(printf '%s' "$data" | jsonfilter -e '@.api.scope')"
	transport="$(printf '%s' "$data" | jsonfilter -e '@.api.transport')"
	revision="$(printf '%s' "$data" | jsonfilter -e '@.api.revision')"
	case "$port:$revision" in *[!0-9:]*|:*|*:) return 1;; esac
	[ "$port" -ge 1 ] && [ "$port" -le 65535 ] && [ "$revision" -ge 1 ] || return 1
	case "$scope" in lan|any) ;; *) return 1;; esac
	case "$transport" in https) opt=-s;; http) opt=-p;; *) return 1;; esac
	if [ "$transport" = https ]; then
		cert="$(uci -q get uhttpd.main.cert)"; cert="${cert:-/etc/uhttpd.crt}"
		key="$(uci -q get uhttpd.main.key)"; key="${key:-/etc/uhttpd.key}"
		if [ ! -s "$cert" ] || [ ! -s "$key" ] || [ ! -f /lib/libustream-ssl.so ]; then
			logger -t sim-relay-api 'HTTPS requires the uhttpd certificate, key and a libustream SSL provider'
			return 1
		fi
	fi
	root="/tmp/sim-relay/api-$revision"
	[ -e /tmp/sim-relay ] || mkdir -m 700 /tmp/sim-relay || return 1
	[ -d /tmp/sim-relay ] && [ ! -L /tmp/sim-relay ] && [ "$(stat -c %u /tmp/sim-relay)" = 0 ] || return 1
	chmod 700 /tmp/sim-relay || return 1
	[ -e "$root" ] || mkdir -m 700 "$root" || return 1
	[ -d "$root" ] && [ ! -L "$root" ] && [ "$(stat -c %u "$root")" = 0 ] || return 1
	[ -e "$root/cgi-bin" ] || mkdir -m 700 "$root/cgi-bin" || return 1
	[ -d "$root/cgi-bin" ] && [ ! -L "$root/cgi-bin" ] && [ ! -L "$root/cgi-bin/api" ] || return 1
	chmod 700 "$root" "$root/cgi-bin" || return 1
	cp /usr/libexec/sim-relay-api "$root/cgi-bin/api" || return 1
	chmod 755 "$root/cgi-bin/api" || return 1
	procd_open_instance
	procd_set_param command /usr/sbin/uhttpd -f -h "$root" -x /cgi-bin -D -t 15 -T 15 -k 0 -n 4 -N 16
	if [ "$transport" = https ]; then procd_append_param command -C "$cert" -K "$key"; fi
	if [ "$scope" = any ]; then
		procd_append_param command "$opt" "0.0.0.0:$port" "$opt" "[::]:$port"
	else
		procd_append_param command "$opt" "127.0.0.1:$port"
		. /lib/functions/network.sh
		printf '%s\n' '127.0.0.0/8' '::1/128' > "$root/allowed-subnets" || return 1
		network_get_subnets addresses lan
		for address in $addresses; do printf '%s\n' "$address" >> "$root/allowed-subnets"; done
		network_get_subnets6 addresses lan
		for address in $addresses; do printf '%s\n' "$address" >> "$root/allowed-subnets"; done
		network_get_ipaddrs addresses lan
		for address in $addresses; do procd_append_param command "$opt" "$address:$port"; done
		network_get_ipaddrs6 addresses lan
		for address in $addresses; do procd_append_param command "$opt" "[$address]:$port"; done
	fi
	procd_set_param respawn 3600 5 5
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger sim-relay uhttpd
	procd_add_interface_trigger 'interface.*' lan /etc/init.d/sim-relay-api restart
}
